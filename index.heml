<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shree Ram Coal Transport Co. — Bilty Management</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg-primary:#0d1017;--bg-secondary:#111520;--bg-card:#161b26;--bg-card-hover:#1c2233;--bg-input:#0f1319;
  --border:#252d40;--border-active:#3a4560;
  --accent-orange:#f4853a;--accent-orange-dim:rgba(244,133,58,0.10);--accent-amber:#e09840;
  --accent-blue:#5294e8;--accent-blue-dim:rgba(82,148,232,0.10);
  --accent-green:#3eb87a;--accent-green-dim:rgba(62,184,122,0.10);
  --accent-red:#e05555;--accent-red-dim:rgba(224,85,85,0.10);
  --accent-yellow:#c8a030;--accent-yellow-dim:rgba(200,160,48,0.10);
  --text-primary:#dde3f0;--text-secondary:#8a95ac;--text-muted:#4e5a72;
  --shadow-card:0 2px 20px rgba(0,0,0,0.42);
  --radius:10px;--radius-sm:8px;--radius-lg:13px;
  --font-display:'Sora',sans-serif;
  --font-body:'Outfit',sans-serif;
  --font-mono:'JetBrains Mono',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font-body);background:var(--bg-primary);color:var(--text-primary);min-height:100vh;overflow-x:hidden;line-height:1.6;}
body::before{content:'';position:fixed;top:-20%;left:-10%;width:700px;height:700px;background:radial-gradient(circle,rgba(244,133,58,0.045) 0%,transparent 70%);pointer-events:none;z-index:0;}
body::after{content:'';position:fixed;bottom:-10%;right:-5%;width:500px;height:500px;background:radial-gradient(circle,rgba(82,148,232,0.03) 0%,transparent 70%);pointer-events:none;z-index:0;}

/* SIDEBAR */
.sidebar{position:fixed;left:0;top:0;bottom:0;width:264px;background:var(--bg-secondary);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:100;transition:transform 0.3s ease;}
.sidebar-logo{padding:22px 18px 18px;border-bottom:1px solid var(--border);}
.logo-mark{display:flex;align-items:center;gap:13px;text-decoration:none;}
.logo-icon{width:44px;height:44px;background:linear-gradient(135deg,#f97316,#dc4e0a);border-radius:11px;display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 4px 20px rgba(249,115,22,0.35);flex-shrink:0;}
.logo-text{font-family:var(--font-display);font-size:14px;font-weight:700;color:var(--text-primary);line-height:1.25;letter-spacing:0.01em;}
.logo-sub{font-family:var(--font-body);font-size:9.5px;color:var(--text-muted);font-weight:500;letter-spacing:0.1em;text-transform:uppercase;margin-top:2px;}
.sidebar-nav{flex:1;padding:14px 10px;overflow-y:auto;}
.nav-section-label{font-family:var(--font-display);font-size:9.5px;font-weight:700;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-muted);padding:10px 10px 5px;margin-top:6px;}
.nav-item{display:flex;align-items:center;gap:12px;padding:10px 14px;border-radius:var(--radius-sm);cursor:pointer;font-family:var(--font-body);font-size:13.5px;font-weight:500;color:var(--text-secondary);transition:all 0.18s ease;margin-bottom:2px;border:1px solid transparent;position:relative;}
.nav-item:hover{background:var(--bg-card);color:var(--text-primary);border-color:var(--border);}
.nav-item.active{background:var(--accent-orange-dim);color:var(--accent-orange);border-color:rgba(244,133,58,0.2);}
.nav-item.active::before{content:'';position:absolute;left:-10px;top:50%;transform:translateY(-50%);width:3px;height:18px;background:var(--accent-orange);border-radius:2px;}
.nav-icon{font-size:15px;width:20px;text-align:center;}
.sidebar-footer{padding:14px 18px;border-top:1px solid var(--border);}
.sidebar-footer-biz{font-family:var(--font-display);font-size:12.5px;font-weight:700;color:var(--accent-orange);margin-bottom:3px;letter-spacing:0.01em;}
.sidebar-footer-sub{font-family:var(--font-body);font-size:10px;color:var(--text-muted);}

/* TOPBAR */
.main-wrap{margin-left:264px;min-height:100vh;display:flex;flex-direction:column;}
.topbar{position:sticky;top:0;background:rgba(9,11,16,0.94);backdrop-filter:blur(18px);border-bottom:1px solid var(--border);padding:0 26px;height:64px;display:flex;align-items:center;justify-content:space-between;z-index:50;}
.topbar-left{display:flex;align-items:center;gap:13px;}
.topbar-title{font-family:var(--font-display);font-size:20px;font-weight:700;color:var(--text-primary);letter-spacing:0.01em;}
.topbar-right{display:flex;align-items:center;gap:10px;}
.topbar-badge{background:var(--accent-orange-dim);border:1px solid rgba(244,133,58,0.25);color:var(--accent-orange);padding:4px 12px;border-radius:20px;font-family:var(--font-body);font-size:11.5px;font-weight:600;letter-spacing:0.03em;}
.hamburger{display:none;background:none;border:1px solid var(--border);color:var(--text-primary);padding:7px 10px;border-radius:var(--radius-sm);cursor:pointer;font-size:17px;}

/* PAGES */
.page{display:none;padding:26px;}
.page.active{display:block;}

/* KPI */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-bottom:22px;}
.kpi-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:22px 20px;position:relative;overflow:hidden;transition:all 0.25s ease;}
.kpi-card:hover{border-color:var(--border-active);transform:translateY(-2px);box-shadow:var(--shadow-card);}
.kpi-card::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;border-radius:var(--radius-lg) var(--radius-lg) 0 0;}
.kpi-card.orange::after{background:linear-gradient(90deg,var(--accent-orange),var(--accent-amber));}
.kpi-card.blue::after{background:linear-gradient(90deg,var(--accent-blue),#7eb8ff);}
.kpi-card.green::after{background:linear-gradient(90deg,var(--accent-green),#5ee09a);}
.kpi-card.yellow::after{background:linear-gradient(90deg,var(--accent-yellow),#f0c040);}
.kpi-label{font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-muted);margin-bottom:10px;}
.kpi-value{font-family:var(--font-display);font-size:27px;font-weight:700;line-height:1;margin-bottom:4px;letter-spacing:-0.01em;}
.kpi-card.orange .kpi-value{color:var(--accent-orange);}
.kpi-card.blue .kpi-value{color:var(--accent-blue);}
.kpi-card.green .kpi-value{color:var(--accent-green);}
.kpi-card.yellow .kpi-value{color:var(--accent-yellow);}
.kpi-sub{font-family:var(--font-body);font-size:11.5px;color:var(--text-muted);}
.kpi-icon{position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:34px;opacity:0.08;}

/* STAT ROW */
.stat-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(155px,1fr));gap:11px;margin-bottom:22px;}
.stat-mini{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px 16px;display:flex;align-items:center;gap:12px;}
.stat-mini-icon{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;}
.stat-mini-icon.coal{background:rgba(239,68,68,0.12);}
.stat-mini-icon.truck{background:rgba(249,115,22,0.12);}
.stat-mini-icon.weight{background:rgba(59,130,246,0.12);}
.stat-mini-icon.money{background:rgba(34,197,94,0.12);}
.stat-mini-val{font-family:var(--font-display);font-size:16px;font-weight:700;color:var(--text-primary);}
.stat-mini-lbl{font-family:var(--font-body);font-size:10.5px;color:var(--text-muted);margin-top:1px;}

/* SECTION HEADER */
.section-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px;}
.section-title{font-family:var(--font-display);font-size:16.5px;font-weight:700;color:var(--text-primary);display:flex;align-items:center;gap:9px;letter-spacing:0.01em;}
.section-title span{font-family:var(--font-body);font-size:12.5px;font-weight:400;color:var(--text-muted);}

/* ENTRY COUNTER BADGE */
.entry-counter{display:inline-flex;align-items:center;gap:7px;background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:7px 15px;font-family:var(--font-body);font-size:13px;font-weight:500;color:var(--text-secondary);}
.entry-counter strong{font-family:var(--font-display);color:var(--accent-orange);font-size:16px;font-weight:700;}

/* FORM */
.form-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);padding:28px;margin-bottom:24px;box-shadow:var(--shadow-card);}
.form-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:17px;}
.form-group{display:flex;flex-direction:column;gap:6px;}
.form-group.full{grid-column:1/-1;}
label{font-family:var(--font-display);font-size:10.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-secondary);}
input,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);font-family:var(--font-body);font-size:14px;font-weight:500;padding:10px 14px;width:100%;transition:all 0.18s ease;outline:none;appearance:none;-webkit-appearance:none;}
input:focus,select:focus,textarea:focus{border-color:var(--accent-orange);background:var(--bg-card);box-shadow:0 0 0 3px rgba(244,133,58,0.13);}
input[readonly]{background:rgba(244,133,58,0.07);border-color:rgba(244,133,58,0.22);color:var(--accent-orange);font-family:var(--font-mono);font-size:13px;font-weight:600;cursor:not-allowed;}
input.calc-result{background:rgba(62,184,122,0.07);border-color:rgba(62,184,122,0.22);color:var(--accent-green);font-family:var(--font-mono);font-size:13px;font-weight:600;}
select option{background:#141922;color:var(--text-primary);}
.form-divider{grid-column:1/-1;border:none;border-top:1px solid var(--border);margin:2px 0;}
.form-section-label{grid-column:1/-1;font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent-orange);padding:4px 0 0;display:flex;align-items:center;gap:9px;}
.form-section-label::after{content:'';flex:1;height:1px;background:var(--border);}
.form-actions{display:flex;gap:10px;justify-content:flex-end;margin-top:20px;padding-top:20px;border-top:1px solid var(--border);flex-wrap:wrap;}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:7px;padding:10px 18px;border-radius:var(--radius-sm);font-family:var(--font-body);font-size:13.5px;font-weight:600;cursor:pointer;border:none;transition:all 0.18s ease;text-decoration:none;white-space:nowrap;letter-spacing:0.01em;}
.btn-primary{background:linear-gradient(135deg,#f97316,#dc4e0a);color:white;box-shadow:0 4px 18px rgba(249,115,22,0.30);}
.btn-primary:hover{background:linear-gradient(135deg,#fb923c,#f97316);transform:translateY(-1px);box-shadow:0 6px 22px rgba(249,115,22,0.40);}
.btn-secondary{background:var(--bg-input);color:var(--text-secondary);border:1px solid var(--border);}
.btn-secondary:hover{background:var(--bg-card-hover);color:var(--text-primary);border-color:var(--border-active);}
.btn-danger{background:var(--accent-red-dim);color:var(--accent-red);border:1px solid rgba(224,85,85,0.2);padding:6px 11px;font-size:12.5px;}
.btn-danger:hover{background:var(--accent-red);color:white;border-color:var(--accent-red);}
.btn-pdf{background:rgba(139,92,246,0.12);color:#b49afa;border:1px solid rgba(139,92,246,0.22);padding:6px 11px;font-size:12.5px;}
.btn-pdf:hover{background:#7c3aed;color:white;border-color:#7c3aed;}
.btn-edit{background:var(--accent-blue-dim);color:var(--accent-blue);border:1px solid rgba(82,148,232,0.2);padding:6px 11px;font-size:12.5px;}
.btn-edit:hover{background:var(--accent-blue);color:white;}
.btn-sm{padding:7px 14px;font-size:12.5px;}

/* TABLE */
.table-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-card);}
.table-toolbar{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:var(--bg-secondary);}
.table-toolbar-left{display:flex;align-items:center;gap:10px;flex-wrap:wrap;flex:1;}
.search-wrap{position:relative;min-width:200px;max-width:320px;flex:1;}
.search-wrap input{padding-left:37px;background:var(--bg-input);}
.search-icon{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);font-size:14px;pointer-events:none;}
.filter-row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;}
.filter-btn{background:var(--bg-input);border:1px solid var(--border);color:var(--text-secondary);padding:5px 13px;border-radius:20px;font-family:var(--font-body);font-size:11.5px;font-weight:600;cursor:pointer;transition:all 0.15s ease;}
.filter-btn:hover,.filter-btn.active{background:var(--accent-orange-dim);color:var(--accent-orange);border-color:rgba(244,133,58,0.28);}
.table-scroll{overflow-x:auto;}
table{width:100%;border-collapse:collapse;font-size:13px;}
thead{background:var(--bg-secondary);border-bottom:1px solid var(--border);}
th{padding:11px 14px;text-align:left;font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);white-space:nowrap;}
td{padding:12px 14px;border-bottom:1px solid var(--border);color:var(--text-primary);vertical-align:middle;}
tr:last-child td{border-bottom:none;}
tbody tr{transition:background 0.15s ease;}
tbody tr:hover{background:var(--bg-card-hover);}
.bilty-num{font-family:var(--font-mono);font-size:12px;color:var(--accent-orange);font-weight:600;}
.route-cell{display:flex;align-items:center;gap:5px;font-size:12.5px;}
.route-arrow{color:var(--text-muted);font-size:10px;}
.weight-cell{font-family:var(--font-mono);font-size:12px;font-weight:500;}
.freight-cell{font-family:var(--font-mono);font-size:12px;color:var(--accent-green);font-weight:600;}
.sno-cell{font-family:var(--font-mono);font-size:11px;color:var(--text-muted);font-weight:600;}
.action-group{display:flex;gap:5px;align-items:center;}
.vehicle-cell{font-family:var(--font-mono);font-size:12px;color:var(--text-primary);font-weight:500;}

/* BADGES */
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:20px;font-family:var(--font-display);font-size:10px;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;white-space:nowrap;}
.badge::before{content:'';width:5px;height:5px;border-radius:50%;background:currentColor;}
.badge-pending{background:var(--accent-yellow-dim);color:var(--accent-yellow);border:1px solid rgba(200,160,48,0.22);}
.badge-transit{background:var(--accent-blue-dim);color:var(--accent-blue);border:1px solid rgba(82,148,232,0.22);}
.badge-delivered{background:var(--accent-green-dim);color:var(--accent-green);border:1px solid rgba(62,184,122,0.22);}

/* EMPTY */
.empty-state{text-align:center;padding:56px 24px;color:var(--text-muted);}
.empty-icon{font-size:44px;margin-bottom:10px;opacity:0.35;}
.empty-title{font-family:var(--font-display);font-size:15px;font-weight:700;color:var(--text-secondary);margin-bottom:5px;}
.empty-sub{font-family:var(--font-body);font-size:12.5px;}

/* RECENT CARD */
.recent-card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;}
.recent-header{padding:14px 18px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--bg-secondary);}

/* TOAST */
.toast-container{position:fixed;bottom:22px;right:22px;z-index:9999;display:flex;flex-direction:column;gap:9px;}
.toast{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:13px 17px;display:flex;align-items:center;gap:10px;min-width:240px;box-shadow:0 8px 36px rgba(0,0,0,0.55);animation:toastIn 0.3s ease;font-family:var(--font-body);font-size:13px;font-weight:500;}
.toast.success{border-left:3px solid var(--accent-green);}
.toast.error{border-left:3px solid var(--accent-red);}
.toast.info{border-left:3px solid var(--accent-blue);}
@keyframes toastIn{from{opacity:0;transform:translateX(20px);}to{opacity:1;transform:translateX(0);}}

/* OVERLAY */
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.55);z-index:99;}

/* SUMMARY */
.summary-table-wrap{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;}

/* PAGINATION BAR */
.pagination-bar{padding:12px 18px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;background:var(--bg-secondary);flex-wrap:wrap;gap:8px;}
.page-info{font-family:var(--font-body);font-size:12px;color:var(--text-muted);}
.page-info strong{color:var(--text-primary);}
.page-btns{display:flex;gap:6px;}
.page-btn{background:var(--bg-input);border:1px solid var(--border);color:var(--text-secondary);padding:5px 13px;border-radius:6px;font-family:var(--font-body);font-size:12px;font-weight:600;cursor:pointer;transition:all 0.15s;}
.page-btn:hover{background:var(--bg-card-hover);color:var(--text-primary);}
.page-btn.active{background:var(--accent-orange-dim);color:var(--accent-orange);border-color:rgba(244,133,58,0.28);}
.page-btn:disabled{opacity:0.35;cursor:not-allowed;}

@media(max-width:900px){
  .sidebar{transform:translateX(-100%);}
  .sidebar.open{transform:translateX(0);}
  .sidebar-overlay.open{display:block;}
  .main-wrap{margin-left:0;}
  .hamburger{display:block;}
  .page{padding:14px;}
  .kpi-grid{grid-template-columns:repeat(2,1fr);}
  .form-grid{grid-template-columns:1fr;}
}
@media(max-width:540px){
  .kpi-grid{grid-template-columns:1fr 1fr;}
  .form-actions{flex-direction:column;}
  .form-actions .btn{width:100%;justify-content:center;}
}
@media print{body{display:none;}}
</style>
</head>
<body>

<div class="sidebar-overlay" id="sidebarOverlay" onclick="closeSidebar()"></div>

<!-- SIDEBAR -->
<nav class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="logo-mark">
      <div class="logo-icon">⛏️</div>
      <div>
        <div class="logo-text">Shree Ram Coal<br>Transport Co.</div>
        <div class="logo-sub">Bilty Management Pro</div>
      </div>
    </div>
  </div>
  <div class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <div class="nav-item active" onclick="showPage('dashboard',this)"><span class="nav-icon">📊</span> Dashboard</div>
    <div class="nav-item" onclick="showPage('newBilty',this)"><span class="nav-icon">📝</span> New Bilty</div>
    <div class="nav-item" onclick="showPage('allBilties',this)"><span class="nav-icon">📋</span> All Bilties</div>
    <div class="nav-section-label">Reports</div>
    <div class="nav-item" onclick="showPage('summary',this)"><span class="nav-icon">📈</span> Summary Report</div>
  </div>
  <div class="sidebar-footer">
    <div class="sidebar-footer-biz">Shree Ram Coal Transport Co.</div>
    <div class="sidebar-footer-sub">GST: 20AABCS1234A1Z5 · Dhanbad, JH</div>
  </div>
</nav>

<!-- MAIN -->
<div class="main-wrap">
  <div class="topbar">
    <div class="topbar-left">
      <button class="hamburger" onclick="toggleSidebar()">☰</button>
      <div class="topbar-title" id="topbarTitle">Dashboard</div>
    </div>
    <div class="topbar-right">
      <div class="topbar-badge" id="topbarDate"></div>
      <button class="btn btn-primary btn-sm" onclick="showPage('newBilty',null)">+ New Bilty</button>
    </div>
  </div>

  <!-- ===== DASHBOARD ===== -->
  <div class="page active" id="page-dashboard">
    <div class="kpi-grid">
      <div class="kpi-card orange"><div class="kpi-label">Total Bilties</div><div class="kpi-value" id="kpiTotal">0</div><div class="kpi-sub">All time records</div><div class="kpi-icon">📋</div></div>
      <div class="kpi-card green"><div class="kpi-label">Total Freight</div><div class="kpi-value" id="kpiFreight">₹0</div><div class="kpi-sub">Gross earnings</div><div class="kpi-icon">💰</div></div>
      <div class="kpi-card blue"><div class="kpi-label">In Transit</div><div class="kpi-value" id="kpiTransit">0</div><div class="kpi-sub">Active trips</div><div class="kpi-icon">🚛</div></div>
      <div class="kpi-card yellow"><div class="kpi-label">Delivered</div><div class="kpi-value" id="kpiDelivered">0</div><div class="kpi-sub">Completed trips</div><div class="kpi-icon">✅</div></div>
    </div>
    <div class="stat-row">
      <div class="stat-mini"><div class="stat-mini-icon coal">⛏️</div><div><div class="stat-mini-val" id="kpiTotalWeight">0 T</div><div class="stat-mini-lbl">Total Coal Moved</div></div></div>
      <div class="stat-mini"><div class="stat-mini-icon truck">🚛</div><div><div class="stat-mini-val" id="kpiVehicles">0</div><div class="stat-mini-lbl">Unique Vehicles</div></div></div>
      <div class="stat-mini"><div class="stat-mini-icon weight">📦</div><div><div class="stat-mini-val" id="kpiPending">0</div><div class="stat-mini-lbl">Pending Bilties</div></div></div>
      <div class="stat-mini"><div class="stat-mini-icon money">💳</div><div><div class="stat-mini-val" id="kpiAvgFreight">₹0</div><div class="stat-mini-lbl">Avg Freight / Trip</div></div></div>
    </div>
    <div class="recent-card">
      <div class="recent-header">
        <div class="section-title">Recent Bilties</div>
        <button class="btn btn-secondary btn-sm" onclick="showPage('allBilties',null)">View All →</button>
      </div>
      <div class="table-scroll">
        <table>
          <thead><tr><th>#</th><th>Bilty No</th><th>Date</th><th>Customer</th><th>Route</th><th>Vehicle</th><th>Net Wt</th><th>Freight</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="dashboardTable"><tr><td colspan="10"><div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">No bilties yet</div></div></td></tr></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- ===== NEW BILTY ===== -->
  <div class="page" id="page-newBilty">
    <div class="section-header">
      <div class="section-title">New Bilty <span>Fill in shipment details</span></div>
      <div id="editingBanner" style="display:none;background:rgba(244,133,58,0.1);border:1px solid rgba(244,133,58,0.3);border-radius:8px;padding:6px 14px;font-family:var(--font-body);font-size:13px;font-weight:600;color:var(--accent-orange);">✏️ Editing existing bilty</div>
    </div>
    <div class="form-card">
      <div class="form-grid">
        <div class="form-section-label">Bilty Information</div>
        <div class="form-group"><label>Bilty Number</label><input type="text" id="biltyNumber" readonly></div>
        <div class="form-group"><label>Date</label><input type="date" id="biltyDate"></div>
        <div class="form-group"><label>Status</label>
          <select id="biltyStatus">
            <option value="Pending">🟡 Pending</option>
            <option value="In Transit">🔵 In Transit</option>
            <option value="Delivered">🟢 Delivered</option>
          </select>
        </div>
        <hr class="form-divider">
        <div class="form-section-label">Customer &amp; Route</div>
        <div class="form-group"><label>Customer Name *</label><input type="text" id="customerName" placeholder="e.g. Ramesh Coal Traders Pvt Ltd"></div>
        <div class="form-group"><label>From Location *</label><input type="text" id="fromLocation" placeholder="e.g. Dhanbad, Jharkhand"></div>
        <div class="form-group"><label>To Location *</label><input type="text" id="toLocation" placeholder="e.g. Raipur, Chhattisgarh"></div>
        <hr class="form-divider">
        <div class="form-section-label">Vehicle &amp; Driver</div>
        <div class="form-group"><label>Vehicle Number *</label><input type="text" id="vehicleNumber" placeholder="e.g. JH 05 AB 1234" style="text-transform:uppercase"></div>
        <div class="form-group"><label>Driver Name</label><input type="text" id="driverName" placeholder="e.g. Suresh Kumar"></div>
        <div class="form-group"><label>Coal Type</label>
          <select id="coalType">
            <option>Steam Coal</option><option>Coking Coal</option><option>Lignite</option>
            <option>Anthracite</option><option>Bituminous</option><option>Sub-Bituminous</option><option>Washery Grade</option>
          </select>
        </div>
        <hr class="form-divider">
        <div class="form-section-label">Weight &amp; Freight</div>
        <div class="form-group"><label>Gross Weight (Tonnes) *</label><input type="number" id="grossWeight" placeholder="0.000" min="0" step="0.001" oninput="calcWeights()"></div>
        <div class="form-group"><label>Tare Weight (Tonnes) *</label><input type="number" id="tareWeight" placeholder="0.000" min="0" step="0.001" oninput="calcWeights()"></div>
        <div class="form-group"><label>Net Weight (Tonnes) — Auto</label><input type="number" id="netWeight" class="calc-result" readonly placeholder="Auto"></div>
        <div class="form-group"><label>Rate Per Tonne (₹)</label><input type="number" id="ratePerTon" placeholder="0.00" min="0" step="0.01" oninput="calcWeights()"></div>
        <div class="form-group"><label>Total Freight (₹) — Auto</label><input type="number" id="totalFreight" class="calc-result" readonly placeholder="Auto"></div>
        <div class="form-group"><label>Remarks</label><input type="text" id="remarks" placeholder="Optional notes..."></div>
      </div>
      <div class="form-actions">
        <button class="btn btn-secondary" onclick="resetForm()">🔄 Reset</button>
        <button class="btn btn-primary" onclick="saveBilty()">💾 Save Bilty</button>
      </div>
    </div>
  </div>

  <!-- ===== ALL BILTIES ===== -->
  <div class="page" id="page-allBilties">
    <div class="section-header">
      <div class="section-title">All Bilties</div>
      <div class="entry-counter">Total Entries: <strong id="entryCountBig">0</strong></div>
    </div>
    <div class="table-card">
      <div class="table-toolbar">
        <div class="table-toolbar-left">
          <div class="search-wrap">
            <span class="search-icon">🔍</span>
            <input type="text" id="searchInput" placeholder="Search bilty, customer, vehicle..." oninput="filterTable()">
          </div>
          <div class="filter-row">
            <button class="filter-btn active" onclick="setFilter('All',this)">All</button>
            <button class="filter-btn" onclick="setFilter('Pending',this)">🟡 Pending</button>
            <button class="filter-btn" onclick="setFilter('In Transit',this)">🔵 Transit</button>
            <button class="filter-btn" onclick="setFilter('Delivered',this)">🟢 Delivered</button>
          </div>
        </div>
        <button class="btn btn-secondary btn-sm" onclick="exportCSV()">📥 Export CSV</button>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>S.No</th><th>Bilty No</th><th>Date</th><th>Customer</th>
              <th>Route</th><th>Vehicle</th><th>Coal Type</th>
              <th>Net Wt</th><th>Rate/T</th><th>Freight</th><th>Status</th><th>Actions</th>
            </tr>
          </thead>
          <tbody id="biltyTableBody"></tbody>
        </table>
      </div>
      <div class="pagination-bar">
        <div class="page-info">Showing <strong id="showFrom">0</strong>–<strong id="showTo">0</strong> of <strong id="showTotal">0</strong> entries</div>
        <div class="page-btns" id="pageBtns"></div>
      </div>
    </div>
  </div>

  <!-- ===== SUMMARY ===== -->
  <div class="page" id="page-summary">
    <div class="section-header">
      <div class="section-title">Summary Report <span>Aggregate analytics</span></div>
      <button class="btn btn-primary btn-sm" onclick="printSummary()">🖨️ Print Report</button>
    </div>
    <div class="kpi-grid" style="margin-bottom:20px">
      <div class="kpi-card orange"><div class="kpi-label">Total Bilties</div><div class="kpi-value" id="smTotal">0</div><div class="kpi-icon">📋</div></div>
      <div class="kpi-card green"><div class="kpi-label">Total Freight</div><div class="kpi-value" id="smFreight">₹0</div><div class="kpi-icon">💰</div></div>
      <div class="kpi-card blue"><div class="kpi-label">Total Net Weight</div><div class="kpi-value" id="smWeight">0T</div><div class="kpi-icon">⚖️</div></div>
      <div class="kpi-card yellow"><div class="kpi-label">Avg Rate/Tonne</div><div class="kpi-value" id="smRate">₹0</div><div class="kpi-icon">📊</div></div>
    </div>
    <div class="summary-table-wrap">
      <div class="recent-header"><div class="section-title">Status-wise Breakdown</div></div>
      <div style="padding:16px 18px;">
        <table>
          <thead><tr><th>Status</th><th>Count</th><th>Total Freight</th><th>Total Net Weight</th><th>Avg Freight/Trip</th></tr></thead>
          <tbody id="summaryBreakdown"></tbody>
        </table>
      </div>
    </div>
  </div>

</div><!-- end main-wrap -->

<div class="toast-container" id="toastContainer"></div>

<script>
// ===================== BUSINESS CONFIG =====================
var BIZ = {
  name:    'Shree Ram Coal Transport Co.',
  address: 'Near Railway Siding, Govindpur, Dhanbad, Jharkhand - 828109',
  phone:   '+91-9876543210',
  gst:     '20AABCS1234A1Z5',
  pan:     'AABCS1234A',
  email:   'shreeram.coal@gmail.com'
};

// ===================== STATE =====================
var bilties = [];
var currentFilter = 'All';
var editingId = null;
var currentPage = 1;
var perPage = 10;
var filteredCache = [];

// ===================== DEMO DATA =====================
var DEMO_DATA = [
  {id:1000,biltyNumber:'CF/2025/0001',date:'2025-01-06',customerName:'Ramesh Coal Traders Pvt Ltd',fromLocation:'Dhanbad, Jharkhand',toLocation:'Raipur, Chhattisgarh',vehicleNumber:'JH05AB1234',driverName:'Suresh Kumar',coalType:'Steam Coal',grossWeight:28.500,tareWeight:8.200,netWeight:20.300,ratePerTon:1850,totalFreight:37555,status:'Delivered',remarks:'First trip of the year',createdAt:'2025-01-06T09:00:00Z'},
  {id:1001,biltyNumber:'CF/2025/0002',date:'2025-01-08',customerName:'M/s Gupta Minerals & Fuels',fromLocation:'Bokaro, Jharkhand',toLocation:'Nagpur, Maharashtra',vehicleNumber:'JH01CD5678',driverName:'Rajesh Yadav',coalType:'Coking Coal',grossWeight:30.100,tareWeight:9.500,netWeight:20.600,ratePerTon:2200,totalFreight:45320,status:'Delivered',remarks:'',createdAt:'2025-01-08T10:30:00Z'},
  {id:1002,biltyNumber:'CF/2025/0003',date:'2025-01-10',customerName:'Birla Power Solutions Ltd',fromLocation:'Ranchi, Jharkhand',toLocation:'Pune, Maharashtra',vehicleNumber:'MH12EF3456',driverName:'Amit Singh',coalType:'Bituminous',grossWeight:27.800,tareWeight:8.000,netWeight:19.800,ratePerTon:1950,totalFreight:38610,status:'In Transit',remarks:'Urgent delivery',createdAt:'2025-01-10T08:15:00Z'},
  {id:1003,biltyNumber:'CF/2025/0004',date:'2025-01-11',customerName:'Tata Steel Ltd — Raw Materials',fromLocation:'Dhanbad, Jharkhand',toLocation:'Jamshedpur, Jharkhand',vehicleNumber:'JH05GH7890',driverName:'Vijay Prasad',coalType:'Coking Coal',grossWeight:32.000,tareWeight:10.000,netWeight:22.000,ratePerTon:2400,totalFreight:52800,status:'Delivered',remarks:'Priority shipment',createdAt:'2025-01-11T07:00:00Z'},
  {id:1004,biltyNumber:'CF/2025/0005',date:'2025-01-13',customerName:'Hindustan Zinc — Fuel Dept',fromLocation:'Bokaro, Jharkhand',toLocation:'Udaipur, Rajasthan',vehicleNumber:'RJ14IJ2345',driverName:'Mohammad Salim',coalType:'Steam Coal',grossWeight:29.500,tareWeight:8.800,netWeight:20.700,ratePerTon:1800,totalFreight:37260,status:'In Transit',remarks:'',createdAt:'2025-01-13T11:00:00Z'},
  {id:1005,biltyNumber:'CF/2025/0006',date:'2025-01-14',customerName:'M/s Shyam Sunder Agarwal & Sons',fromLocation:'Giridih, Jharkhand',toLocation:'Bilaspur, Chhattisgarh',vehicleNumber:'CG04KL6789',driverName:'Deepak Tiwari',coalType:'Washery Grade',grossWeight:26.200,tareWeight:7.500,netWeight:18.700,ratePerTon:1600,totalFreight:29920,status:'Pending',remarks:'',createdAt:'2025-01-14T09:30:00Z'},
  {id:1006,biltyNumber:'CF/2025/0007',date:'2025-01-15',customerName:'NTPC Ltd — Kahalgaon Plant',fromLocation:'Dhanbad, Jharkhand',toLocation:'Kahalgaon, Bihar',vehicleNumber:'BR01MN4567',driverName:'Santosh Mahato',coalType:'Steam Coal',grossWeight:31.500,tareWeight:9.200,netWeight:22.300,ratePerTon:1750,totalFreight:39025,status:'Delivered',remarks:'Monthly supply',createdAt:'2025-01-15T06:45:00Z'},
  {id:1007,biltyNumber:'CF/2025/0008',date:'2025-01-16',customerName:'M/s Jain Fuels & Logistics',fromLocation:'Hazaribagh, Jharkhand',toLocation:'Kolkata, West Bengal',vehicleNumber:'WB20OP8901',driverName:'Ranjit Mondal',coalType:'Sub-Bituminous',grossWeight:28.000,tareWeight:8.500,netWeight:19.500,ratePerTon:1700,totalFreight:33150,status:'In Transit',remarks:'',createdAt:'2025-01-16T10:00:00Z'},
  {id:1008,biltyNumber:'CF/2025/0009',date:'2025-01-17',customerName:'DLF Power Ltd',fromLocation:'Jharia, Jharkhand',toLocation:'Ludhiana, Punjab',vehicleNumber:'PB10QR2345',driverName:'Harpreet Singh',coalType:'Anthracite',grossWeight:25.800,tareWeight:7.200,netWeight:18.600,ratePerTon:2600,totalFreight:48360,status:'Pending',remarks:'Premium grade',createdAt:'2025-01-17T08:20:00Z'},
  {id:1009,biltyNumber:'CF/2025/0010',date:'2025-01-18',customerName:'JSW Steel — Procurement',fromLocation:'Bokaro, Jharkhand',toLocation:'Vijayanagar, Karnataka',vehicleNumber:'KA01ST6789',driverName:'Krishnamurthy R',coalType:'Coking Coal',grossWeight:33.000,tareWeight:10.500,netWeight:22.500,ratePerTon:2350,totalFreight:52875,status:'Delivered',remarks:'',createdAt:'2025-01-18T07:30:00Z'},
  {id:1010,biltyNumber:'CF/2025/0011',date:'2025-01-19',customerName:'Adani Power Maharashtra Ltd',fromLocation:'Dhanbad, Jharkhand',toLocation:'Tiroda, Maharashtra',vehicleNumber:'MH04UV1234',driverName:'Pramod Kharche',coalType:'Steam Coal',grossWeight:30.500,tareWeight:9.000,netWeight:21.500,ratePerTon:1900,totalFreight:40850,status:'In Transit',remarks:'Weekly consignment',createdAt:'2025-01-19T09:00:00Z'},
  {id:1011,biltyNumber:'CF/2025/0012',date:'2025-01-20',customerName:'M/s Sharma Brothers Coal',fromLocation:'Giridih, Jharkhand',toLocation:'Kanpur, Uttar Pradesh',vehicleNumber:'UP32WX5678',driverName:'Ramakant Dubey',coalType:'Lignite',grossWeight:24.500,tareWeight:7.000,netWeight:17.500,ratePerTon:1450,totalFreight:25375,status:'Pending',remarks:'',createdAt:'2025-01-20T11:15:00Z'}
];

// ===================== INIT =====================
document.addEventListener('DOMContentLoaded', function() {
  loadFromStorage();
  setTodayDate();
  generateBiltyNumber();
  updateTopbarDate();
  updateDashboard();
  renderAllBilties();
  renderSummary();
});

function loadFromStorage() {
  var data = localStorage.getItem('srcol_bilties_v2');
  if (data) {
    bilties = JSON.parse(data);
  } else {
    bilties = DEMO_DATA.map(function(d){ return Object.assign({},d); });
    saveToStorage();
  }
}

function saveToStorage() {
  localStorage.setItem('srcol_bilties_v2', JSON.stringify(bilties));
}

function setTodayDate() {
  var t = new Date();
  document.getElementById('biltyDate').value = t.getFullYear() + '-' + pad(t.getMonth()+1) + '-' + pad(t.getDate());
}

function pad(n){ return String(n).padStart(2,'0'); }

function updateTopbarDate() {
  var n = new Date();
  document.getElementById('topbarDate').textContent = n.toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'});
}

function generateBiltyNumber() {
  var yr = new Date().getFullYear();
  var existing = bilties.filter(function(b){ return b.biltyNumber.indexOf('CF/'+yr+'/') === 0; });
  var max = 0;
  existing.forEach(function(b){
    var parts = b.biltyNumber.split('/');
    var n = parseInt(parts[2]) || 0;
    if(n > max) max = n;
  });
  document.getElementById('biltyNumber').value = 'CF/' + yr + '/' + String(max+1).padStart(4,'0');
}

// ===================== NAVIGATION =====================
function showPage(pageId, navEl) {
  document.querySelectorAll('.page').forEach(function(p){ p.classList.remove('active'); });
  document.getElementById('page-'+pageId).classList.add('active');
  document.querySelectorAll('.nav-item').forEach(function(n){ n.classList.remove('active'); });
  if(navEl) navEl.classList.add('active');
  var titles = {dashboard:'Dashboard',newBilty:'New Bilty',allBilties:'All Bilties',summary:'Summary Report'};
  document.getElementById('topbarTitle').textContent = titles[pageId] || 'Dashboard';
  if(pageId==='allBilties'){ currentPage=1; renderAllBilties(); }
  if(pageId==='dashboard') updateDashboard();
  if(pageId==='summary') renderSummary();
  if(pageId==='newBilty' && !editingId) generateBiltyNumber();
  closeSidebar();
}

function toggleSidebar(){ document.getElementById('sidebar').classList.toggle('open'); document.getElementById('sidebarOverlay').classList.toggle('open'); }
function closeSidebar(){ document.getElementById('sidebar').classList.remove('open'); document.getElementById('sidebarOverlay').classList.remove('open'); }

// ===================== CALCULATIONS =====================
function calcWeights() {
  var g = parseFloat(document.getElementById('grossWeight').value)||0;
  var t = parseFloat(document.getElementById('tareWeight').value)||0;
  var r = parseFloat(document.getElementById('ratePerTon').value)||0;
  var net = Math.max(0, g-t);
  document.getElementById('netWeight').value  = net > 0 ? net.toFixed(3) : '';
  document.getElementById('totalFreight').value = net > 0 ? (net*r).toFixed(2) : '';
}

// ===================== SAVE =====================
function saveBilty() {
  var customer = document.getElementById('customerName').value.trim();
  var from     = document.getElementById('fromLocation').value.trim();
  var to       = document.getElementById('toLocation').value.trim();
  var vehicle  = document.getElementById('vehicleNumber').value.trim();
  var gross    = parseFloat(document.getElementById('grossWeight').value);
  var tare     = parseFloat(document.getElementById('tareWeight').value);

  if(!customer||!from||!to||!vehicle){ showToast('Please fill all required fields','error'); return; }
  if(isNaN(gross)||isNaN(tare)){ showToast('Please enter valid weights','error'); return; }
  var net = gross-tare;
  if(net<0){ showToast('Net weight cannot be negative!','error'); return; }
  var rate = parseFloat(document.getElementById('ratePerTon').value)||0;

  var bilty = {
    id: editingId||Date.now(),
    biltyNumber: document.getElementById('biltyNumber').value,
    date: document.getElementById('biltyDate').value,
    customerName: customer,
    fromLocation: from,
    toLocation: to,
    vehicleNumber: vehicle.toUpperCase(),
    driverName: document.getElementById('driverName').value.trim(),
    coalType: document.getElementById('coalType').value,
    grossWeight: gross,
    tareWeight: tare,
    netWeight: net,
    ratePerTon: rate,
    totalFreight: net*rate,
    status: document.getElementById('biltyStatus').value,
    remarks: document.getElementById('remarks').value.trim(),
    createdAt: editingId ? (bilties.find(function(b){return b.id===editingId;})||{}).createdAt||new Date().toISOString() : new Date().toISOString()
  };

  if(editingId){
    var idx = bilties.findIndex(function(b){return b.id===editingId;});
    if(idx>=0) bilties[idx]=bilty;
    showToast('Bilty updated! '+bilty.biltyNumber,'success');
    editingId=null;
    document.getElementById('editingBanner').style.display='none';
  } else {
    bilties.push(bilty);
    showToast('Bilty saved! '+bilty.biltyNumber,'success');
  }
  saveToStorage();
  updateDashboard();
  renderSummary();
  resetForm();
  currentPage=1;
  showPage('allBilties',null);
}

function resetForm() {
  editingId=null;
  document.getElementById('editingBanner').style.display='none';
  ['customerName','fromLocation','toLocation','vehicleNumber','driverName','grossWeight','tareWeight','netWeight','ratePerTon','totalFreight','remarks'].forEach(function(id){ document.getElementById(id).value=''; });
  document.getElementById('coalType').value='Steam Coal';
  document.getElementById('biltyStatus').value='Pending';
  setTodayDate();
  generateBiltyNumber();
}

function deleteBilty(id) {
  if(!confirm('Delete this bilty? This cannot be undone.')) return;
  bilties = bilties.filter(function(b){return b.id!==id;});
  saveToStorage();
  updateDashboard();
  renderAllBilties();
  renderSummary();
  showToast('Bilty deleted.','info');
}

function editBilty(id) {
  var b = bilties.find(function(b){return b.id===id;});
  if(!b) return;
  editingId=id;
  document.getElementById('biltyNumber').value = b.biltyNumber;
  document.getElementById('biltyDate').value    = b.date;
  document.getElementById('customerName').value = b.customerName;
  document.getElementById('fromLocation').value = b.fromLocation;
  document.getElementById('toLocation').value   = b.toLocation;
  document.getElementById('vehicleNumber').value= b.vehicleNumber;
  document.getElementById('driverName').value   = b.driverName;
  document.getElementById('coalType').value     = b.coalType;
  document.getElementById('grossWeight').value  = b.grossWeight;
  document.getElementById('tareWeight').value   = b.tareWeight;
  document.getElementById('netWeight').value    = b.netWeight;
  document.getElementById('ratePerTon').value   = b.ratePerTon;
  document.getElementById('totalFreight').value = b.totalFreight;
  document.getElementById('biltyStatus').value  = b.status;
  document.getElementById('remarks').value      = b.remarks||'';
  document.getElementById('editingBanner').style.display='block';
  showPage('newBilty',null);
}

// ===================== RENDER ALL BILTIES (with pagination) =====================
function getFiltered() {
  var search = (document.getElementById('searchInput').value||'').toLowerCase();
  return bilties.filter(function(b){
    var mf = currentFilter==='All'||b.status===currentFilter;
    var ms = !search||(
      b.biltyNumber.toLowerCase().indexOf(search)>=0||
      b.customerName.toLowerCase().indexOf(search)>=0||
      b.vehicleNumber.toLowerCase().indexOf(search)>=0||
      b.fromLocation.toLowerCase().indexOf(search)>=0||
      b.toLocation.toLowerCase().indexOf(search)>=0||
      (b.driverName||'').toLowerCase().indexOf(search)>=0||
      b.coalType.toLowerCase().indexOf(search)>=0
    );
    return mf&&ms;
  });
}

function renderAllBilties() {
  filteredCache = getFiltered().slice().reverse();
  var total = filteredCache.length;
  var totalPages = Math.ceil(total/perPage)||1;
  if(currentPage>totalPages) currentPage=totalPages;
  var start = (currentPage-1)*perPage;
  var end   = Math.min(start+perPage, total);
  var pageItems = filteredCache.slice(start,end);

  document.getElementById('entryCountBig').textContent = bilties.length;
  document.getElementById('showFrom').textContent = total?start+1:0;
  document.getElementById('showTo').textContent   = end;
  document.getElementById('showTotal').textContent = total;

  var tbody = document.getElementById('biltyTableBody');
  if(!pageItems.length){
    tbody.innerHTML = '<tr><td colspan="12"><div class="empty-state"><div class="empty-icon">🔍</div><div class="empty-title">No bilties found</div><div class="empty-sub">Adjust search or filter</div></div></td></tr>';
  } else {
    var html='';
    pageItems.forEach(function(b,i){
      var sno = start+i+1;
      html+='<tr>';
      html+='<td><span class="sno-cell">'+sno+'</span></td>';
      html+='<td><span class="bilty-num">'+esc(b.biltyNumber)+'</span></td>';
      html+='<td style="white-space:nowrap;font-size:12.5px;">'+fmtDate(b.date)+'</td>';
      html+='<td style="max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;" title="'+esc(b.customerName)+'">'+esc(b.customerName)+'</td>';
      html+='<td><div class="route-cell">'+esc(b.fromLocation)+'<span class="route-arrow">→</span>'+esc(b.toLocation)+'</div></td>';
      html+='<td><span class="vehicle-cell">'+esc(b.vehicleNumber)+'</span></td>';
      html+='<td style="font-size:12.5px;">'+esc(b.coalType)+'</td>';
      html+='<td><span class="weight-cell">'+b.netWeight.toFixed(3)+' T</span></td>';
      html+='<td><span style="font-family:var(--font-mono);font-size:12px;">₹'+fmtNum(b.ratePerTon)+'</span></td>';
      html+='<td><span class="freight-cell">₹'+fmtNum(b.totalFreight)+'</span></td>';
      html+='<td>'+statusBadge(b.status)+'</td>';
      html+='<td><div class="action-group">';
      html+='<button class="btn btn-pdf" onclick="downloadPDF('+b.id+')" title="Download PDF">📄 PDF</button>';
      html+='<button class="btn btn-edit" onclick="editBilty('+b.id+')" title="Edit">✏️</button>';
      html+='<button class="btn btn-danger" onclick="deleteBilty('+b.id+')" title="Delete">🗑️</button>';
      html+='</div></td>';
      html+='</tr>';
    });
    tbody.innerHTML=html;
  }

  var pageBtns='';
  pageBtns+='<button class="page-btn" onclick="goPage('+(currentPage-1)+')" '+(currentPage<=1?'disabled':'')+'>‹ Prev</button>';
  var start_pg = Math.max(1,currentPage-2), end_pg = Math.min(totalPages,start_pg+4);
  for(var p=start_pg;p<=end_pg;p++){
    pageBtns+='<button class="page-btn'+(p===currentPage?' active':'')+'" onclick="goPage('+p+')">'+p+'</button>';
  }
  pageBtns+='<button class="page-btn" onclick="goPage('+(currentPage+1)+')" '+(currentPage>=totalPages?'disabled':'')+'>Next ›</button>';
  document.getElementById('pageBtns').innerHTML=pageBtns;
}

function goPage(p){
  var total = filteredCache.length;
  var totalPages = Math.ceil(total/perPage)||1;
  if(p<1||p>totalPages) return;
  currentPage=p;
  renderAllBilties();
}

function setFilter(f,el){
  currentFilter=f; currentPage=1;
  document.querySelectorAll('.filter-btn').forEach(function(b){b.classList.remove('active');});
  if(el) el.classList.add('active');
  renderAllBilties();
}

function filterTable(){ currentPage=1; renderAllBilties(); }

// ===================== DASHBOARD =====================
function updateDashboard(){
  var total=bilties.length;
  var tf=bilties.reduce(function(s,b){return s+b.totalFreight;},0);
  var transit=bilties.filter(function(b){return b.status==='In Transit';}).length;
  var delivered=bilties.filter(function(b){return b.status==='Delivered';}).length;
  var pending=bilties.filter(function(b){return b.status==='Pending';}).length;
  var tw=bilties.reduce(function(s,b){return s+b.netWeight;},0);
  var vehicles=new Set(bilties.map(function(b){return b.vehicleNumber;})).size;
  var avg=total?tf/total:0;

  document.getElementById('kpiTotal').textContent=total;
  document.getElementById('kpiFreight').textContent='₹'+fmtShort(tf);
  document.getElementById('kpiTransit').textContent=transit;
  document.getElementById('kpiDelivered').textContent=delivered;
  document.getElementById('kpiTotalWeight').textContent=tw.toFixed(1)+' T';
  document.getElementById('kpiVehicles').textContent=vehicles;
  document.getElementById('kpiPending').textContent=pending;
  document.getElementById('kpiAvgFreight').textContent='₹'+fmtNum(Math.round(avg));

  var recent=bilties.slice(-8).reverse();
  var tbody=document.getElementById('dashboardTable');
  if(!recent.length){
    tbody.innerHTML='<tr><td colspan="10"><div class="empty-state"><div class="empty-icon">📦</div><div class="empty-title">No bilties yet</div></div></td></tr>';
    return;
  }
  var html='',i=0;
  recent.forEach(function(b){
    i++;
    html+='<tr>';
    html+='<td><span class="sno-cell">'+i+'</span></td>';
    html+='<td><span class="bilty-num">'+esc(b.biltyNumber)+'</span></td>';
    html+='<td style="white-space:nowrap;font-size:12.5px;">'+fmtDate(b.date)+'</td>';
    html+='<td style="max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;">'+esc(b.customerName)+'</td>';
    html+='<td><div class="route-cell">'+esc(b.fromLocation)+'<span class="route-arrow">→</span>'+esc(b.toLocation)+'</div></td>';
    html+='<td><span class="vehicle-cell">'+esc(b.vehicleNumber)+'</span></td>';
    html+='<td><span class="weight-cell">'+b.netWeight.toFixed(3)+' T</span></td>';
    html+='<td><span class="freight-cell">₹'+fmtNum(b.totalFreight)+'</span></td>';
    html+='<td>'+statusBadge(b.status)+'</td>';
    html+='<td><button class="btn btn-pdf btn-sm" onclick="downloadPDF('+b.id+')" style="font-size:11px;padding:5px 9px;">📄 PDF</button></td>';
    html+='</tr>';
  });
  tbody.innerHTML=html;
}

// ===================== SUMMARY =====================
function renderSummary(){
  var total=bilties.length;
  var tf=bilties.reduce(function(s,b){return s+b.totalFreight;},0);
  var tw=bilties.reduce(function(s,b){return s+b.netWeight;},0);
  var tr2=bilties.reduce(function(s,b){return s+b.ratePerTon;},0);
  document.getElementById('smTotal').textContent=total;
  document.getElementById('smFreight').textContent='₹'+fmtShort(tf);
  document.getElementById('smWeight').textContent=tw.toFixed(1)+'T';
  document.getElementById('smRate').textContent='₹'+Math.round(total?tr2/total:0);
  var html='';
  ['Pending','In Transit','Delivered'].forEach(function(s){
    var sub=bilties.filter(function(b){return b.status===s;});
    var cnt=sub.length;
    var fr=sub.reduce(function(a,b){return a+b.totalFreight;},0);
    var wt=sub.reduce(function(a,b){return a+b.netWeight;},0);
    html+='<tr><td>'+statusBadge(s)+'</td>';
    html+='<td style="font-family:var(--font-mono);font-size:13px;font-weight:600;">'+cnt+'</td>';
    html+='<td style="font-family:var(--font-mono);font-size:13px;font-weight:600;color:var(--accent-green);">₹'+fmtNum(fr)+'</td>';
    html+='<td style="font-family:var(--font-mono);font-size:13px;">'+wt.toFixed(2)+' T</td>';
    html+='<td style="font-family:var(--font-mono);font-size:13px;">₹'+fmtNum(cnt?Math.round(fr/cnt):0)+'</td></tr>';
  });
  document.getElementById('summaryBreakdown').innerHTML=html;
}

// ===================== PDF / PRINT PER ENTRY =====================
function downloadPDF(id){
  var b=bilties.find(function(x){return x.id===id;});
  if(!b) return;
  var win=window.open('','_blank','width=960,height=750,scrollbars=yes');
  win.document.write(buildPrintHTML(b));
  win.document.close();
  win.focus();
  setTimeout(function(){ win.print(); },800);
}

function buildPrintHTML(b){
  var inWords = amountToWords(Math.round(b.totalFreight));
  return '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Bilty '+esc(b.biltyNumber)+'</title>' +
  '<link rel="preconnect" href="https://fonts.googleapis.com">' +
  '<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">' +
  '<style>' +
  '*{box-sizing:border-box;margin:0;padding:0;}' +
  'body{font-family:Outfit,sans-serif;background:#e8eaf0;color:#111827;font-size:13px;line-height:1.6;}' +
  '.sheet{width:210mm;min-height:297mm;margin:0 auto;background:#fff;box-shadow:0 0 40px rgba(0,0,0,0.18);}' +

  /* HEADER */
  '.hdr{background:linear-gradient(135deg,#0f172a 0%,#1e293b 60%,#0f3460 100%);color:#fff;padding:24px 30px 18px;position:relative;overflow:hidden;}' +
  '.hdr::before{content:"⛏";position:absolute;right:20px;top:-10px;font-size:110px;opacity:0.06;}' +
  '.hdr-inner{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;}' +
  '.biz-name{font-family:Sora,sans-serif;font-size:26px;font-weight:700;letter-spacing:0.02em;color:#fff;line-height:1.15;}' +
  '.biz-detail{font-size:11px;color:rgba(255,255,255,0.65);margin-top:6px;line-height:1.8;font-family:Outfit,sans-serif;}' +
  '.hdr-right{text-align:right;flex-shrink:0;}' +
  '.doc-type{font-family:Sora,sans-serif;font-size:10px;letter-spacing:0.2em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-bottom:4px;}' +
  '.doc-bilty-title{font-family:Sora,sans-serif;font-size:26px;font-weight:700;color:#f97316;letter-spacing:0.08em;}' +
  '.doc-num{font-family:"JetBrains Mono",monospace;font-size:15px;font-weight:600;color:#fbbf24;margin-top:5px;}' +
  '.doc-date{font-size:11.5px;color:rgba(255,255,255,0.65);margin-top:4px;font-family:Outfit,sans-serif;}' +

  /* STATUS BAR */
  '.sbar{display:flex;align-items:center;justify-content:space-between;padding:9px 30px;border-bottom:2px solid #e2e8f0;background:#f8fafc;}' +
  '.schip{display:inline-flex;align-items:center;gap:6px;padding:4px 14px;border-radius:20px;font-family:Sora,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;}' +
  '.schip.Pending{background:#fef9c3;color:#7c4b00;border:1px solid #fde047;}' +
  '.schip.Transit{background:#dbeafe;color:#1e3a8a;border:1px solid #93c5fd;}' +
  '.schip.Delivered{background:#dcfce7;color:#14532d;border:1px solid #86efac;}' +
  '.sbar-id{font-family:"JetBrains Mono",monospace;font-size:11px;color:#111827;font-weight:600;}' +

  /* BODY */
  '.body{padding:16px 30px 0;}' +
  '.sec{margin-bottom:14px;}' +
  '.sec-title{font-family:Sora,sans-serif;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#f97316;margin-bottom:8px;padding-bottom:5px;border-bottom:1.5px solid #e2e8f0;display:flex;align-items:center;gap:8px;}' +
  '.g2{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;}' +
  '.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px 14px;}' +
  '.g4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:8px 14px;}' +
  '.fld{background:#f8fafc;border:1px solid #e2e8f0;border-radius:7px;padding:9px 13px;}' +
  '.fld-l{font-family:Sora,sans-serif;font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#111827;margin-bottom:4px;}' +
  '.fld-v{font-family:Outfit,sans-serif;font-size:14px;font-weight:600;color:#111827;}' +
  '.fld-v.mono{font-family:"JetBrains Mono",monospace;font-size:13px;font-weight:600;color:#111827;}' +
  '.fld-v.orange{color:#c2410c;font-weight:700;}' +
  '.fld-v.big{font-size:16px;font-weight:700;color:#c2410c;}' +

  /* WEIGHT TABLE */
  '.wt{width:100%;border-collapse:collapse;border:1px solid #e2e8f0;border-radius:8px;overflow:hidden;}' +
  '.wt th{background:#1e293b;color:#f1f5f9;padding:9px 14px;font-family:Sora,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;text-align:left;}' +
  '.wt td{padding:10px 14px;border-bottom:1px solid #f1f5f9;font-family:Outfit,sans-serif;font-size:13.5px;font-weight:500;color:#111827;}' +
  '.wt tr:last-child td{border-bottom:none;background:#fff7ed;font-weight:700;color:#1a1a1a;}' +
  '.wt .r{text-align:right;font-family:"JetBrains Mono",monospace;font-size:13px;font-weight:600;color:#111827;}' +
  '.wt tr:last-child .r{color:#c2410c;font-size:14px;}' +

  /* FREIGHT BOX */
  '.fbox{background:linear-gradient(135deg,#0f172a,#1e3a5f);border-radius:10px;padding:18px 24px;display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;}' +
  '.fbox-left .fl{font-family:Sora,sans-serif;font-size:10px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:rgba(255,255,255,0.6);}' +
  '.fbox-left .fw{font-family:Sora,sans-serif;font-size:30px;font-weight:700;color:#4ade80;letter-spacing:0.02em;line-height:1.1;}' +
  '.fbox-left .fd{font-family:"JetBrains Mono",monospace;font-size:11px;color:rgba(255,255,255,0.55);margin-top:4px;}' +
  '.fbox-right{text-align:right;}' +
  '.fbox-right .iw-l{font-family:Sora,sans-serif;font-size:9px;color:rgba(255,255,255,0.5);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:4px;}' +
  '.fbox-right .iw{font-family:Outfit,sans-serif;font-size:12.5px;color:#fbbf24;font-weight:600;max-width:210px;text-align:right;line-height:1.5;}' +

  /* SIGNATURES */
  '.sig-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-top:12px;padding-top:14px;border-top:1px dashed #cbd5e1;}' +
  '.sig-box{text-align:center;}' +
  '.sig-line{border-bottom:1.5px solid #374151;margin-bottom:6px;height:44px;}' +
  '.sig-lbl{font-family:Sora,sans-serif;font-size:9px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#111827;}' +

  /* FOOTER */
  '.pfooter{margin-top:14px;padding:10px 30px;background:#f8fafc;border-top:2px solid #e2e8f0;display:flex;justify-content:space-between;align-items:center;}' +
  '.pf-note{font-family:Outfit,sans-serif;font-size:10px;color:#111827;font-style:italic;}' +
  '.pf-stamp{font-family:Sora,sans-serif;font-size:14px;font-weight:700;color:#1e293b;letter-spacing:0.1em;}' +

  '.watermark{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) rotate(-35deg);font-family:Sora,sans-serif;font-size:100px;font-weight:700;color:rgba(249,115,22,0.03);pointer-events:none;z-index:0;letter-spacing:0.1em;white-space:nowrap;}' +
  '.no-print{background:#f1f5f9;padding:16px;text-align:center;border-top:2px solid #e2e8f0;display:flex;gap:12px;justify-content:center;flex-wrap:wrap;}' +
  '.np-btn{padding:10px 24px;border-radius:8px;font-family:Sora,sans-serif;font-size:14px;font-weight:700;cursor:pointer;border:none;letter-spacing:0.02em;}' +
  '.np-btn.primary{background:#f97316;color:#fff;}' +
  '.np-btn.sec{background:#e2e8f0;color:#374151;}' +
  '@media print{.no-print{display:none!important;}.sheet{box-shadow:none;}.watermark{display:none;}body{background:#fff;}-webkit-print-color-adjust:exact;print-color-adjust:exact;}' +
  '</style></head><body>' +
  '<div class="watermark">SHREE RAM COAL</div>' +
  '<div class="sheet">' +

  /* HEADER */
  '<div class="hdr"><div class="hdr-inner">' +
  '<div><div class="biz-name">⛏️ '+esc(BIZ.name)+'</div>' +
  '<div class="biz-detail">'+esc(BIZ.address)+'<br>📞 '+esc(BIZ.phone)+' &nbsp;|&nbsp; ✉️ '+esc(BIZ.email)+'<br>GST: '+esc(BIZ.gst)+' &nbsp;|&nbsp; PAN: '+esc(BIZ.pan)+'</div></div>' +
  '<div class="hdr-right"><div class="doc-type">Transport Goods Receipt</div><div class="doc-bilty-title">BILTY</div><div class="doc-num">'+esc(b.biltyNumber)+'</div><div class="doc-date">Date: '+fmtDateLong(b.date)+'</div></div>' +
  '</div></div>' +

  /* STATUS BAR */
  '<div class="sbar"><span class="sbar-id">Doc: '+esc(b.biltyNumber)+' &nbsp;|&nbsp; Printed: '+new Date().toLocaleString('en-IN')+'</span>'+printChip(b.status)+'</div>' +

  '<div class="body">' +

  /* CUSTOMER & ROUTE */
  '<div class="sec"><div class="sec-title">📋 Customer &amp; Consignment Details</div>' +
  '<div class="g2">' +
  '<div class="fld"><div class="fld-l">Consignee / Customer Name</div><div class="fld-v">'+esc(b.customerName)+'</div></div>' +
  '<div class="fld"><div class="fld-l">Remarks / Notes</div><div class="fld-v">'+(b.remarks?esc(b.remarks):'—')+'</div></div>' +
  '<div class="fld"><div class="fld-l">📍 Loading Point (From)</div><div class="fld-v orange">'+esc(b.fromLocation)+'</div></div>' +
  '<div class="fld"><div class="fld-l">📍 Delivery Point (To)</div><div class="fld-v orange">'+esc(b.toLocation)+'</div></div>' +
  '</div></div>' +

  /* VEHICLE & CARGO */
  '<div class="sec"><div class="sec-title">🚛 Vehicle &amp; Cargo Details</div>' +
  '<div class="g3">' +
  '<div class="fld"><div class="fld-l">Vehicle Number</div><div class="fld-v mono">'+esc(b.vehicleNumber)+'</div></div>' +
  '<div class="fld"><div class="fld-l">Driver Name</div><div class="fld-v">'+(b.driverName?esc(b.driverName):'—')+'</div></div>' +
  '<div class="fld"><div class="fld-l">Coal / Material Type</div><div class="fld-v">'+esc(b.coalType)+'</div></div>' +
  '</div></div>' +

  /* WEIGHT TABLE */
  '<div class="sec"><div class="sec-title">⚖️ Weight Details</div>' +
  '<table class="wt"><thead><tr><th>Description</th><th class="r">Weight (Metric Tonnes)</th><th>Remarks</th></tr></thead>' +
  '<tbody>' +
  '<tr><td>Gross Weight (Loaded Vehicle)</td><td class="r">'+b.grossWeight.toFixed(3)+' MT</td><td>At Loading Point</td></tr>' +
  '<tr><td>Tare Weight (Empty Vehicle)</td><td class="r">'+b.tareWeight.toFixed(3)+' MT</td><td>Vehicle Tare</td></tr>' +
  '<tr><td><strong>Net Weight (Coal / Material)</strong></td><td class="r"><strong>'+b.netWeight.toFixed(3)+' MT</strong></td><td>Gross − Tare</td></tr>' +
  '</tbody></table></div>' +

  /* FREIGHT BOX */
  '<div class="fbox">' +
  '<div class="fbox-left"><div class="fl">Total Freight Payable</div><div class="fw">₹ '+fmtNum(b.totalFreight)+'</div><div class="fd">@ ₹'+fmtNum(b.ratePerTon)+'/MT × '+b.netWeight.toFixed(3)+' MT</div></div>' +
  '<div class="fbox-right"><div class="iw-l">Amount in Words</div><div class="iw">'+inWords+'</div></div>' +
  '</div>' +

  /* SIGNATURES */
  '<div class="sig-row">' +
  '<div class="sig-box"><div class="sig-line"></div><div class="sig-lbl">Driver Signature &amp; Thumb</div></div>' +
  '<div class="sig-box"><div class="sig-line"></div><div class="sig-lbl">Receiver / Consignee</div></div>' +
  '<div class="sig-box"><div class="sig-line"></div><div class="sig-lbl">Authorized Signatory</div></div>' +
  '</div>' +

  '</div>' +

  '<div class="pfooter"><div class="pf-note">This is a computer-generated transport document. Subject to verification. All disputes are subject to Dhanbad jurisdiction only.</div><div class="pf-stamp">SHREE RAM COAL TRANSPORT CO.</div></div>' +
  '</div>' +

  '<div class="no-print">' +
  '<button class="np-btn primary" onclick="window.print()">🖨️ Print / Save PDF</button>' +
  '<button class="np-btn sec" onclick="window.close()">✕ Close</button>' +
  '</div>' +
  '</body></html>';
}

function printChip(s){
  if(s==='In Transit') return '<span class="schip Transit">🔵 In Transit</span>';
  if(s==='Delivered')  return '<span class="schip Delivered">🟢 Delivered</span>';
  return '<span class="schip Pending">🟡 Pending</span>';
}

// ===================== SUMMARY PRINT =====================
function printSummary(){
  var total=bilties.length;
  var tf=bilties.reduce(function(s,b){return s+b.totalFreight;},0);
  var tw=bilties.reduce(function(s,b){return s+b.netWeight;},0);
  var rows='';
  bilties.slice().reverse().forEach(function(b,i){
    rows+='<tr style="'+(i%2===0?'background:#f9fafb;':'')+'">';
    rows+='<td style="font-family:JetBrains Mono,monospace;font-size:11px;color:#111827;font-weight:600;">'+(i+1)+'</td>';
    rows+='<td style="font-family:JetBrains Mono,monospace;font-size:12px;color:#c2410c;font-weight:600;">'+esc(b.biltyNumber)+'</td>';
    rows+='<td style="color:#111827;font-size:12.5px;">'+fmtDate(b.date)+'</td>';
    rows+='<td style="color:#111827;font-size:12.5px;font-weight:500;">'+esc(b.customerName)+'</td>';
    rows+='<td style="color:#111827;font-size:12px;">'+esc(b.fromLocation)+' → '+esc(b.toLocation)+'</td>';
    rows+='<td style="font-family:JetBrains Mono,monospace;font-size:12px;color:#111827;font-weight:600;">'+esc(b.vehicleNumber)+'</td>';
    rows+='<td style="color:#111827;font-size:12px;">'+esc(b.coalType)+'</td>';
    rows+='<td style="text-align:right;font-family:JetBrains Mono,monospace;color:#111827;font-weight:600;">'+b.netWeight.toFixed(3)+' T</td>';
    rows+='<td style="text-align:right;font-family:JetBrains Mono,monospace;color:#111827;font-weight:600;">₹'+fmtNum(b.ratePerTon)+'</td>';
    rows+='<td style="text-align:right;font-family:JetBrains Mono,monospace;font-weight:700;color:#15803d;">₹'+fmtNum(b.totalFreight)+'</td>';
    rows+='<td style="font-size:11px;font-weight:700;color:#111827;">'+b.status+'</td>';
    rows+='</tr>';
  });
  var html='<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Summary Report — '+esc(BIZ.name)+'</title>' +
  '<link rel="preconnect" href="https://fonts.googleapis.com">' +
  '<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=JetBrains+Mono:wght@500;600&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">' +
  '<style>*{box-sizing:border-box;margin:0;padding:0;}body{font-family:Outfit,sans-serif;font-size:12px;color:#111827;background:#e8eaf0;}' +
  '.sheet{max-width:297mm;margin:0 auto;background:#fff;padding:24px;box-shadow:0 0 30px rgba(0,0,0,0.12);}' +
  '.hdr{background:linear-gradient(135deg,#0f172a,#1e293b);color:#fff;border-radius:10px;padding:18px 24px;margin-bottom:18px;display:flex;justify-content:space-between;align-items:flex-start;}' +
  '.h-biz{font-family:Sora,sans-serif;font-size:24px;font-weight:700;}' +
  '.h-sub{font-size:11px;color:rgba(255,255,255,0.6);margin-top:4px;font-family:Outfit,sans-serif;}' +
  '.h-right{text-align:right;font-size:11px;color:rgba(255,255,255,0.65);font-family:Outfit,sans-serif;}' +
  '.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px;}' +
  '.kpi{border:1px solid #e2e8f0;border-radius:8px;padding:12px 14px;background:#f8fafc;}' +
  '.kpi-l{font-family:Sora,sans-serif;font-size:9.5px;text-transform:uppercase;letter-spacing:0.1em;color:#111827;margin-bottom:5px;font-weight:700;}' +
  '.kpi-v{font-family:Sora,sans-serif;font-size:22px;font-weight:700;color:#111827;}' +
  'table{width:100%;border-collapse:collapse;}' +
  'thead{background:#1e293b;}' +
  'th{padding:9px 10px;font-family:Sora,sans-serif;font-size:9.5px;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#e2e8f0;text-align:left;}' +
  'td{padding:8px 10px;border-bottom:1px solid #f1f5f9;font-size:12px;color:#111827;}' +
  '.total-row td{font-weight:700;background:#fff7ed;border-top:2px solid #f97316;color:#111827;font-family:Sora,sans-serif;}' +
  '.no-print{text-align:center;padding:18px;background:#f8fafc;border-top:1px solid #e2e8f0;display:flex;gap:10px;justify-content:center;}' +
  '.np{padding:10px 24px;border-radius:6px;font-family:Sora,sans-serif;font-size:13px;font-weight:700;cursor:pointer;border:none;}' +
  '@media print{.no-print{display:none!important;}.sheet{box-shadow:none;padding:0;}-webkit-print-color-adjust:exact;print-color-adjust:exact;}' +
  '</style></head><body>' +
  '<div class="sheet">' +
  '<div class="hdr"><div><div class="h-biz">⛏️ '+esc(BIZ.name)+'</div><div class="h-sub">'+esc(BIZ.address)+' &nbsp;|&nbsp; GST: '+esc(BIZ.gst)+'</div></div>' +
  '<div class="h-right"><div style="font-family:Sora,sans-serif;font-size:16px;font-weight:700;color:#f97316;">Summary Report</div><div>Generated: '+new Date().toLocaleString('en-IN')+'</div><div>Total Records: '+total+'</div></div></div>' +
  '<div class="kpis"><div class="kpi"><div class="kpi-l">Total Bilties</div><div class="kpi-v">'+total+'</div></div><div class="kpi"><div class="kpi-l">Total Freight</div><div class="kpi-v">₹'+fmtNum(tf)+'</div></div><div class="kpi"><div class="kpi-l">Total Net Wt</div><div class="kpi-v">'+tw.toFixed(2)+' T</div></div><div class="kpi"><div class="kpi-l">Avg Freight</div><div class="kpi-v">₹'+fmtNum(total?Math.round(tf/total):0)+'</div></div></div>' +
  '<table><thead><tr><th>#</th><th>Bilty No</th><th>Date</th><th>Customer</th><th>Route</th><th>Vehicle</th><th>Coal Type</th><th style="text-align:right">Net Wt</th><th style="text-align:right">Rate/T</th><th style="text-align:right">Freight</th><th>Status</th></tr></thead>' +
  '<tbody>'+rows+'<tr class="total-row"><td colspan="7">GRAND TOTAL</td><td style="text-align:right;font-family:JetBrains Mono,monospace;">'+tw.toFixed(3)+' T</td><td></td><td style="text-align:right;font-family:JetBrains Mono,monospace;color:#c2410c;">₹'+fmtNum(tf)+'</td><td></td></tr></tbody></table>' +
  '</div>' +
  '<div class="no-print"><button class="np" onclick="window.print()" style="background:#f97316;color:#fff;">🖨️ Print / Download PDF</button><button class="np" onclick="window.close()" style="background:#e2e8f0;color:#374151;">✕ Close</button></div>' +
  '</body></html>';
  var win=window.open('','_blank','width=1100,height=780');
  win.document.write(html);
  win.document.close();
}

// ===================== EXPORT CSV =====================
function exportCSV(){
  var headers=['S.No','Bilty Number','Date','Customer Name','From','To','Vehicle Number','Driver Name','Coal Type','Gross Wt (T)','Tare Wt (T)','Net Wt (T)','Rate/Tonne','Total Freight','Status','Remarks'];
  var rows=bilties.slice().reverse().map(function(b,i){
    return [i+1,b.biltyNumber,b.date,b.customerName,b.fromLocation,b.toLocation,b.vehicleNumber,b.driverName,b.coalType,b.grossWeight,b.tareWeight,b.netWeight,b.ratePerTon,b.totalFreight,b.status,b.remarks||''];
  });
  var csv=headers.join(',')+'\n'+rows.map(function(r){return r.map(function(c){return '"'+String(c).replace(/"/g,'""')+'"';}).join(',');}).join('\n');
  var blob=new Blob([csv],{type:'text/csv'});
  var url=URL.createObjectURL(blob);
  var a=document.createElement('a');
  a.href=url; a.download='bilties_'+new Date().toISOString().slice(0,10)+'.csv';
  a.click(); URL.revokeObjectURL(url);
  showToast('CSV exported successfully!','success');
}

// ===================== AMOUNT IN WORDS =====================
function amountToWords(n){
  var a=['','One','Two','Three','Four','Five','Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen'];
  var b=['','','Twenty','Thirty','Forty','Fifty','Sixty','Seventy','Eighty','Ninety'];
  function conv(n){
    if(n===0) return '';
    if(n<20) return a[n]+' ';
    if(n<100) return b[Math.floor(n/10)]+' '+(n%10?a[n%10]+' ':'');
    if(n<1000) return a[Math.floor(n/100)]+' Hundred '+(n%100?conv(n%100):'');
    if(n<100000) return conv(Math.floor(n/1000))+' Thousand '+(n%1000?conv(n%1000):'');
    if(n<10000000) return conv(Math.floor(n/100000))+' Lakh '+(n%100000?conv(n%100000):'');
    return conv(Math.floor(n/10000000))+' Crore '+(n%10000000?conv(n%10000000):'');
  }
  if(n===0) return 'Zero Rupees Only';
  return 'Rupees '+conv(n).trim()+' Only';
}

// ===================== HELPERS =====================
function statusBadge(s){
  if(s==='In Transit') return '<span class="badge badge-transit">In Transit</span>';
  if(s==='Delivered')  return '<span class="badge badge-delivered">Delivered</span>';
  return '<span class="badge badge-pending">Pending</span>';
}
function fmtNum(n){ if(isNaN(n)) return '0'; return Math.round(n).toLocaleString('en-IN'); }
function fmtShort(n){ if(n>=10000000) return (n/10000000).toFixed(1)+'Cr'; if(n>=100000) return (n/100000).toFixed(1)+'L'; if(n>=1000) return (n/1000).toFixed(1)+'K'; return Math.round(n).toLocaleString('en-IN'); }
function fmtDate(d){ if(!d) return '—'; var p=d.split('-'); if(p.length!==3) return d; var m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']; return p[2]+' '+m[parseInt(p[1])-1]+' '+p[0]; }
function fmtDateLong(d){ if(!d) return '—'; var p=d.split('-'); if(p.length!==3) return d; var m=['January','February','March','April','May','June','July','August','September','October','November','December']; return p[2]+' '+m[parseInt(p[1])-1]+', '+p[0]; }
function esc(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

// ===================== TOAST =====================
function showToast(msg,type){
  var c=document.getElementById('toastContainer');
  var t=document.createElement('div');
  t.className='toast '+(type||'info');
  var ico=type==='success'?'✅':type==='error'?'❌':'ℹ️';
  t.innerHTML='<span style="font-size:15px;">'+ico+'</span><span>'+msg+'</span>';
  c.appendChild(t);
  setTimeout(function(){ t.style.opacity='0'; t.style.transform='translateX(20px)'; t.style.transition='all 0.3s ease'; setTimeout(function(){ if(t.parentNode) c.removeChild(t); },300); },3500);
}
</script>
</body>
</html>
